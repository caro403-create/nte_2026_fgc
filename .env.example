# Copia este archivo como `.env` para trabajar en local.
# En Vercel estas mismas variables van en Settings → Environment Variables.

# --- Supabase (cliente; la publishable key es pública por diseño) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Claves de capas del observatorio (cliente) ---
VITE_OWM_KEY=
VITE_FIRMS_KEY=

# --- Google Earth Engine (SOLO servidor: las leen las funciones de api/) ---
# Ojo con el prefijo VITE_: se conserva por compatibilidad, pero estas dos
# nunca deben referenciarse desde código del navegador — si se importan con
# import.meta.env en un componente, Vite las incrusta en el bundle público.
VITE_GEE_SERVICE_ACCOUNT_EMAIL=
# La clave privada va en una sola línea, con los saltos escritos como \n
VITE_GEE_PRIVATE_KEY=

# --- Telegram Bot (Serverless Webhook en api/telegram) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# --- Opcional ---
# Solo si el backend se aloja en otro dominio distinto al de la web.
# En el despliegue normal de Vercel se deja vacío: /api vive en el mismo sitio.
VITE_API_URL=
